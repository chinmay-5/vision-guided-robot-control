<launch>
    
    <!-- Declare arguments. The values can be changed/ set in terminal with roslaunch -->
	<arg name="tf_publish" default="true" doc="Run tf static_transform_publisher. Childs frame name: 'camera_frame'" />
        <arg name="sim" default="true" doc="Launches fake controllers. Use false to start/ connect to real robot." />
        <arg name="use_rviz" default="true" doc="Launches rviz. If you want to launch your own rviz node with own settings, use false." />
    
    <!-- Starting usb_cam node with parameters as defined between the node tags-->
    <node pkg="usb_cam" type="usb_cam_node" name="cam_node" output="screen">
    	<param name="video_device" value="/dev/video0" />
    	<param name="camera_name" value="cam_4" />
    	<param name="camera_frame_id" value="camera_frame" />
    	<param name="camera_info_url" value="file://$(find webcam_artag_pose)/config/default_cam_calibration.yaml" />
    </node>
    
    <include file="$(find ar_track_alvar)/launch/pr2_indiv_no_kinect.launch">
    	<arg name="cam_image_topic" value="/cam_node/image_raw"/>
    	<arg name="cam_info_topic" value="/cam_node/camera_info"/>
    	<arg name="output_frame" value="camera_frame"/>
    </include>
    
    <node pkg='tf' type='static_transform_publisher' name='tf_pub' if='$(arg tf_publish)' args='0.29 0.05 0.53 0 0 3.14 map camera_frame 10'/>
    <node pkg="tf" type="static_transform_publisher" name="my_static_transform_pub" args="0.76 0 0 0 0 0 map base_link 10"/>

    <!-- Start a simulated robot -->
    <include file="$(find ur3e_moveit_config)/launch/demo.launch" if="$(arg sim)">
        <arg name="use_rviz" value="false" />
    </include>

    <!-- Start the real robot -->
    <include file="$(find ur_robot_driver)/launch/ur3e_bringup.launch" unless="$(arg sim)">
        <arg name="robot_ip" value="192.168.0.3" />
    </include>
    <include file="$(find ur3e_moveit_config)/launch/moveit_planning_execution.launch" unless="$(arg sim)"/>
    
    <node pkg = "robot_environment" type = "configure_robot_env.py" name = "obstacles_node" output = "screen">
    </node> 
    <!-- Starting rviz -->
    <node pkg="rviz" name="rviz" type="rviz" args="-d $(find webcam_artag_pose)/config/rviz_001.rviz"/>

</launch>
